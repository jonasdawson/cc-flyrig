#!/bin/bash
# init-user.sh — personal devcontainer overrides
#
# Copy this file to .devcontainer/init-user.sh (gitignored) and uncomment
# whatever you need. It is sourced at the end of init-container.sh, so all
# standard git / uv / jq tooling is already available.
#
# Nothing here is required — it is purely an escape hatch for personal setup
# that you don't want to commit to the repo.

# ── Git identity ─────────────────────────────────────────────────────────────
# Alternative to setting GIT_USER_NAME / GIT_USER_EMAIL as host env vars:
#
# git config --global user.name  "Your Name"
# git config --global user.email "you@example.com"

# ── SSH commit signing (recommended) ─────────────────────────────────────────
# VS Code forwards your host ssh-agent into the container automatically, so a
# signing key held in an agent (Bitwarden, 1Password, ssh-agent, gpg-agent's ssh
# emulation, a hardware key) is usable here with no mount and no key material
# ever landing on disk.  Nothing in init-container.sh configures signing for you
# — set it up here.
#
# user.signingkey takes the *public* key in git's literal form; git resolves the
# private half through the agent.  Pass it in via GIT_SIGNING_KEY in your
# devcontainer.json containerEnv rather than hardcoding it, if you prefer.
#
# git config --global gpg.format    ssh
# git config --global user.signingkey "key::ssh-ed25519 AAAA..."
# git config --global commit.gpgsign true
# git config --global tag.gpgsign    true
#
# Optional, so `git log --show-signature` can verify locally rather than just
# reporting "no principal matched":
#
# mkdir -p "$HOME/.config/git"
# echo 'you@example.com namespaces="git" ssh-ed25519 AAAA...' > "$HOME/.config/git/allowed_signers"
# git config --global gpg.ssh.allowedSignersFile "$HOME/.config/git/allowed_signers"

# ── GPG commit signing (legacy alternative) ──────────────────────────────────
# If you sign with GPG instead, the key has to reach the container somehow —
# either a forwarded gpg-agent socket or an imported private key (which means
# exporting it to your host filesystem first, and bind-mounting it in via your
# own gitignored devcontainer.json).  Prefer the SSH path above if you can.
#
# gpg --import /path/to/private-key.asc
# git config --global gpg.format    gpg
# git config --global user.signingkey <KEY_ID>
# git config --global commit.gpgsign true
# git config --global tag.gpgsign    true

# ── Claude statusline ────────────────────────────────────────────────────────
# If you have a custom statusline script on your host, copy it from the
# read-only host-claude bind mount and wire it up here.
#
# PYTHON=/usr/local/python/current/bin/python3
# uv pip install --system colorama
# cp /tmp/host-claude/statusline.py /tmp/host-claude/statusline.sh ~/.claude/ 2>/dev/null || true
# jq --arg cmd "$PYTHON /home/node/.claude/statusline.py" \
#   '.statusLine.command = $cmd' \
#   ~/.claude/settings.json > /tmp/cc-settings-user.json \
#   && mv /tmp/cc-settings-user.json ~/.claude/settings.json

# ── Other personal git config ─────────────────────────────────────────────────
# git config --global core.editor    vim
# git config --global pull.rebase    true
# git config --global push.autoSetupRemote true
